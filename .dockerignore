# Contexto de build de la imagen de producción: solo lo que el servidor
# necesita en ejecución. Comprobado con grep (oct-2026) qué rutas lee la app;
# si añades una lectura nueva fuera de node/, public/, migrations/, templates/,
# scripts/ o data/, revisa esta lista.

# Control de versiones, CI, editores
.git
.gitignore
.github
.claude
.vscode
.idea
.DS_Store

# Secretos y entorno: van por variables de Coolify, nunca en la imagen
.env
.env.*
.secrets
*.pem
*.key

# Ficheros de construcción (Coolify reescribe el Dockerfile con los ARG del
# entorno: no debe acabar copiado dentro de /app)
Dockerfile
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# Dependencias: se instalan dentro de la imagen con npm ci
node_modules
**/node_modules
npm-debug.log*
*.log

# Documentación. La app SÍ lee estas tres cosas de docs/:
#   docs/templates/            (exporter/render-form-b.js)
#   docs/PROMPTS_CAG/*.md      (master/cag-pipeline.js)
#   docs/form_part_b_eacea.json (migrations/047)
**/*.md
docs/*
!docs/templates
!docs/PROMPTS_CAG
!docs/form_part_b_eacea.json

# Carpetas que el servidor no usa (la web pública se sirve desde public/web)
tmp
video
web
supabase
infra
public/uploads

# Datos que solo usan scripts manuales o el cron del host, no el servidor
data/bdns
data/calls
data/seed_evaluator_letters
data/knowledge_base
data/academia
data/templates
data/*.csv
data/*.xlsx
data/call_pdfs
data/call_extracts
# Montados como volumen en producción (el contenido del repo no se usa)
data/call_vectors
data/call_vectors_local
data/call_structured
# Estado por entorno (se escribe en ejecución)
data/call_curation.json
