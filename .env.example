# ── Database ──────────────────────────────────
DB_HOST=wordpress-eufunding-db-1
DB_PORT=3306
DB_USER=root
DB_PASS=changeme
DB_NAME=eplus_tools

# ── Auth ──────────────────────────────────────
JWT_SECRET=changeme-use-a-64-char-random-string
JWT_REFRESH_SECRET=changeme-use-another-64-char-random-string

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=production
# Origen principal (el dominio donde se sirve Studio). APP_URL también se admite solo.
CORS_ORIGIN=https://eufundingstudio.com
# Lista separada por comas de orígenes que pueden llamar a la API. Si se define,
# sustituye a la lista por defecto de server.js (CORS_ORIGIN + APP_URL + localhost).
# CORS_ORIGINS=https://eufundingstudio.com,https://www.eufundingstudio.com
# URL pública de Studio: enlaces de los correos (confirmar email, recuperar contraseña,
# bienvenida) y del pie de los correos.
APP_URL=https://eufundingstudio.com

# ── Acceso con Google (Google Identity Services) ──
# Client ID OAuth web; el dominio de APP_URL debe estar en «Orígenes de JavaScript
# autorizados» del cliente en Google Cloud. Vacío = se oculta el botón de Google.
GOOGLE_CLIENT_ID=

# ── Acceso propio de Studio ───────────────────
# Studio tiene su propio registro/login (email+contraseña y Google). Las variables
# OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, OIDC_REDIRECT_URI, OIDC_SIGNUP_FLOW
# y OIDC_TRUST_UNVERIFIED_EMAIL YA NO SE USAN (se quitó el login externo, oct-2026):
# se pueden borrar del entorno.

# ── Correo transaccional (Resend) ─────────────
# Sin RESEND_API_KEY no se envía nada (solo se registra en el log).
RESEND_API_KEY=
# Remitente: dominio verificado en Resend.
EMAIL_FROM=no-reply@eufundingstudio.com
# Nombre del remitente (por defecto «EU Funding Studio»).
# EMAIL_FROM_NAME=EU Funding Studio
# A quién se avisa de cada alta nueva (por defecto, Óscar).
# NEW_USER_NOTIFY_EMAIL=

# ── GoHighLevel / centralize.es CRM + email (Fase 4 sync) ────
# Leave blank to disable: subscribers will still be captured locally,
# but no contact will be pushed to GHL. Useful for dev.
# Get the Private Integration token from your GHL/centralize panel:
#   Settings → Business Profile → Private Integrations → New
# Or for centralize white-label: ask their support if not visible.
GHL_API_KEY=
# Find this in the URL of your sub-account: /v2/location/<LOCATION_ID>/...
GHL_LOCATION_ID=
# Both white-label and official GHL share the same backend.
# Override only if your provider uses a different endpoint.
GHL_API_BASE=https://services.leadconnectorhq.com
# Optional: API version header (default 2021-07-28 — current as of 2026).
# GHL_API_VERSION=2021-07-28
# Set to 'true' to force-disable sync even if the keys are filled.
# GHL_DISABLED=false
